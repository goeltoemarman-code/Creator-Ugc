import { GoogleGenAI } from "@google/genai";

const ai = new GoogleGenAI({
  apiKey: process.env.GEMINI_API_KEY,
});

export default async function handler(req: any, res: any) {
  if (req.method !== "POST") {
    return res.status(405).json({
      error: "Method not allowed",
    });
  }

  try {
    const {
      topic,
      language = "Bahasa Indonesia",
      audience = "umum",
    } = req.body || {};

    if (!topic || !topic.trim()) {
      return res.status(400).json({
        error: "Topik wajib diisi.",
      });
    }

    const prompt = `
Anda adalah mesin riset untuk membuat produk PDF digital berkualitas.

TOPIK:
${topic}

BAHASA:
${language}

TARGET PEMBACA:
${audience}

TUGAS:

Lakukan riset mendalam terhadap topik tersebut menggunakan sumber online
yang relevan dan dapat dipercaya.

Prioritaskan:

1. Situs pemerintah
2. Universitas
3. Organisasi resmi
4. Jurnal ilmiah
5. Dokumentasi resmi
6. Lembaga profesional
7. Sumber edukasi terpercaya
8. Buku atau sumber perpustakaan yang dapat digunakan secara legal
9. Sumber lain yang relevan dan memiliki reputasi baik

JANGAN menyalin isi sumber secara langsung.

Gunakan sumber tersebut untuk:
- memahami topik
- menemukan fakta penting
- menemukan konsep utama
- menemukan masalah yang sering dialami pembaca
- menemukan langkah praktis
- menemukan subtopik penting
- menemukan kesalahan umum
- menemukan hal yang perlu diperhatikan
- menemukan informasi yang perlu diverifikasi

HASILKAN JSON SAJA.

Format:

{
  "topic": "",
  "researchSummary": "",
  "keyFacts": [],
  "importantConcepts": [],
  "commonProblems": [],
  "practicalPoints": [],
  "recommendedSections": [],
  "verificationNeeded": [],
  "sources": [
    {
      "title": "",
      "url": "",
      "reason": ""
    }
  ]
}

ATURAN:

- Semua hasil harus relevan dengan TOPIK.
- Jangan memasukkan subtopik hanya karena terlihat populer.
- Jangan mengarang URL.
- Jangan mengarang fakta.
- Jika suatu informasi tidak dapat dipastikan, masukkan ke "verificationNeeded".
- Jangan menyalin artikel atau buku.
- Gunakan informasi sebagai bahan sintesis.
- Jika topik membutuhkan sumber resmi terbaru, prioritaskan sumber terbaru.
`;

    const response = await ai.models.generateContent({
      model: "gemini-3.8-flash",
      contents: prompt,
      config: {
        tools: [
          {
            googleSearch: {},
          },
        ],
        responseMimeType: "application/json",
      },
    });

    const text = response.text || "{}";

    let result;

    try {
      result = JSON.parse(text);
    } catch {
      return res.status(500).json({
        error: "AI menghasilkan format JSON yang tidak valid.",
        raw: text,
      });
    }

    return res.status(200).json(result);
  } catch (error: any) {
    console.error("Research API Error:", error);

    return res.status(500).json({
      error: error?.message || "Terjadi kesalahan saat melakukan riset.",
    });
  }
}
